# Copy to .env.local to turn on or change the search for local development. Without it the search is off; turned on
# without the Typesense settings below, it uses the production search (https://search.nuts.nl).

# Search page and search field in the navigation. Off unless set to "true".
NEXT_PUBLIC_SEARCH_ENABLED=false
# Another Typesense, such as a local one, and its search-only key. Never put an admin key here: it ends up in the browser.
NEXT_PUBLIC_TYPESENSE_URL=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
