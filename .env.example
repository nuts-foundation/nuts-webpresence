# Copy to .env.local to use another search for local development. Without it, the site uses the production search
# (https://search.nuts.nl).

# Another Typesense, such as a local one, and its search-only key. Never put an admin key here: it ends up in the browser.
NEXT_PUBLIC_TYPESENSE_URL=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
