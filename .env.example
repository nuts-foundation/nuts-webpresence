# Copy to .env.local to change the search for local development. Without it, the site uses the production search
# (https://search.nuts.nl), and the search is off unless you turn it on in your browser with ?enable-search=1.

# Search page and search field in the navigation for everyone. Off unless set to "true".
NEXT_PUBLIC_SEARCH_ENABLED=false
# Another Typesense, such as a local one, and its search-only key. Never put an admin key here: it ends up in the browser.
NEXT_PUBLIC_TYPESENSE_URL=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
