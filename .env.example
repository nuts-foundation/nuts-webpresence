# Copy to .env (docker compose, indexer) and .env.local (Next.js). Never commit the real values.

# Typesense admin key: only for docker compose and the indexer. E.g. `openssl rand -hex 32`.
TYPESENSE_API_KEY=
# Typesense address used by the indexer.
TYPESENSE_HOST=http://localhost:8108
# Search-only key for the browser. The indexer creates a key with this value that can only search the collection.
# Choose a different random value than the admin key, e.g. `openssl rand -hex 32`.
TYPESENSE_SEARCH_KEY=

# Search page and search field in the navigation. Off unless set to "true"; testers can still turn it on in their own
# browser with ?enable-search=1.
NEXT_PUBLIC_SEARCH_ENABLED=false
# Typesense address used by the browser.
NEXT_PUBLIC_TYPESENSE_URL=http://localhost:8108
# Same value as TYPESENSE_SEARCH_KEY. Never put the admin key here.
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
