# Copy to .env (docker compose, indexer) and .env.local (Next.js). Never commit the real values.

# Meilisearch master key: only for docker compose and the indexer. At least 16 bytes, e.g. `openssl rand -base64 32`.
MEILI_MASTER_KEY=
# Meilisearch address used by the indexer.
MEILI_HOST=http://localhost:7700

# Search page and search field in the navigation. Off unless set to "true".
NEXT_PUBLIC_SEARCH_ENABLED=false
# Meilisearch address used by the browser.
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
# Search-only key, printed by the indexer at the end of a run. Never put the master key here.
NEXT_PUBLIC_MEILI_SEARCH_KEY=
